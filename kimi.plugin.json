{
  "name": "kimi-memory-plus",
  "version": "0.1.0",
  "description": "Workspace-scoped long-term memory and bounded session recall for Kimi Code.",
  "keywords": ["memory", "recall", "cross-session", "cjk"],
  "author": "QIANLING-0831",
  "homepage": "https://github.com/QIANLING-0831/dsh-memory-plus",
  "license": "MIT",
  "skills": "./packages/kimi-memory-plugin/skills/",
  "systemPromptPath": "./packages/kimi-memory-plugin/SYSTEM.md",
  "sessionStart": {
    "skill": "using-memory"
  },
  "mcpServers": {
    "memory": {
      "command": "node",
      "args": ["./packages/kimi-memory-plugin/server/index.js"],
      "cwd": "./"
    }
  },
  "hooks": [
    {
      "event": "SessionHeartbeat",
      "command": "node ./packages/kimi-memory-plugin/hooks/index-session.mjs",
      "timeout": 30
    },
    {
      "event": "SessionEnd",
      "command": "node ./packages/kimi-memory-plugin/hooks/index-session.mjs",
      "timeout": 30
    },
    {
      "event": "PostCompact",
      "command": "node ./packages/kimi-memory-plugin/hooks/index-session.mjs",
      "timeout": 30
    }
  ],
  "interface": {
    "displayName": "Kimi Memory Plus",
    "shortDescription": "Cross-session memory and bounded recall",
    "longDescription": "Stores explicit workspace facts and indexes session transcripts for model-invoked, token-bounded recall.",
    "developerName": "QIANLING-0831",
    "websiteURL": "https://github.com/QIANLING-0831/dsh-memory-plus"
  }
}
